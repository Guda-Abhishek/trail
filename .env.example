DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED
DB_USERNAME=<username>
DB_PASSWORD=<password>
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Gmail SMTP - Invoice "Send to Client" delivery.
# MAIL_USERNAME is the sending Gmail address; MAIL_PASSWORD must be a
# Gmail App Password (https://myaccount.google.com/apppasswords), never the
# account's real login password. Never commit real values here or in .env.
MAIL_USERNAME=<gmail-account>
MAIL_PASSWORD=<gmail-app-password>

# Local development only: activates application-local.properties (expense FX development assumptions, NOT an
# approved production policy). Leave unset in deployed environments.
# spring.profiles.active=local
